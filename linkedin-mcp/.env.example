# Copy to .env and adjust if needed.

# Persistent Chromium profile (logged-in LinkedIn session). Keep OUT of git.
LI_PROFILE_DIR=./browser_profile

# "1" = headless for inbox/reply. Login always opens a visible window.
# LinkedIn often challenges headless — set 0 if list_inbox fails after login.
LI_HEADLESS=1

LI_SLOWMO=0
LI_TIMEOUT=45000
LI_DEBUG_DIR=./debug
