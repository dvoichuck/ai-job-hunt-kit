# Copy to .env and adjust if needed.

# Where the persistent browser profile (your logged-in DOU session) is stored.
# Keep this OUT of git. Default: ./browser_profile
DOU_PROFILE_DIR=./browser_profile

# Run the browser headless for automated actions (search/apply/profile).
# "1" = headless (no window), "0" = show the window.
# Login always opens a visible window regardless of this setting.
DOU_HEADLESS=1

# Slow down actions by N ms (helpful for debugging / avoiding rate limits).
DOU_SLOWMO=0

# Default per-page navigation timeout, ms.
DOU_TIMEOUT=30000

# Where debug screenshots / HTML dumps are written.
DOU_DEBUG_DIR=./debug
